# =============================================================
# BeaconSync - variáveis de ambiente
# 1. Copie este arquivo:  cp .env.example .env
# 2. Troque os valores no .env (use só letras e números nas senhas)
# O .env está no .gitignore e NUNCA deve ir para o GitHub.
# A API (./gradlew bootRun) e o Docker Compose leem o mesmo .env.
# =============================================================

# --- Banco Oracle ---------------------------------------------
# Opção 1 (padrão): Oracle Free no Docker. Deixe a URL como está.
# Opção 2: servidor da FIAP. Troque as 3 linhas abaixo por:
#   DB_URL=jdbc:oracle:thin:@oracle.fiap.com.br:1521:ORCL
#   DB_USERNAME=rmXXXXXX      (seu RM)
#   DB_PASSWORD=sua senha do Oracle da FIAP
DB_URL=jdbc:oracle:thin:@//localhost:1521/FREEPDB1
DB_USERNAME=beaconsync
DB_PASSWORD=TroqueEstaSenha123

# Senha do SYS/SYSTEM do container Oracle (só usada no Docker)
ORACLE_ADMIN_PASSWORD=TroqueEstaSenhaAdmin123

# --- RabbitMQ (usado a partir da etapa 3) ---------------------
RABBITMQ_HOST=localhost
RABBITMQ_USERNAME=beaconsync
RABBITMQ_PASSWORD=TroqueEstaSenhaRabbit123

# --- Segurança (usado a partir da etapa 2) --------------------
# Gere um valor aleatório com: openssl rand -base64 48
JWT_SECRET=TroquePorUmSegredoAleatorioComPeloMenos32Caracteres
# Senha dos usuários de teste criados ao subir a API
SEED_PASSWORD=Teste123

# --- IA (usado a partir da etapa 4) ---------------------------
# none   -> triagem por regra fixa, não precisa de chave
# openai -> usa o modelo da OpenAI (preencha OPENAI_API_KEY)
AI_PROVIDER=none
OPENAI_API_KEY=